# Production: leave unset or use this origin (a trailing slash is accepted).
# Staging/preview: set this to that deployment's own origin before building.
NEXT_PUBLIC_SITE_URL=https://haloshield.ae

# Optional private review switch; true keeps even a production-origin build noindex.
NEXT_PUBLIC_NOINDEX=false

# GTM-P865Z5BZ is configured in src/lib/deployment.ts and loads only on
# https://haloshield.ae. No private analytics keys are needed in this repo.
