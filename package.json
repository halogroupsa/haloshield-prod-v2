{
  "name": "halo-shield-df-v2-stag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "build:clean": "rm -rf .next out && next build",
    "preview": "wrangler pages dev out --port 4321",
    "deploy": "npm run pages:deploy",
    "lint": "eslint",
    "images": "python3 scripts/optimize-images.py ../shield-new-site-prod/src/assets public/images src/lib/images.generated.ts",
    "start": "wrangler pages dev out",
    "pages:preview": "wrangler pages dev out",
    "typecheck": "next typegen && tsc --noEmit",
    "test:sync": "node --test scripts/test-sync-to-prod.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run verify:export && npm run verify:deployment",
    "pages:deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.156.2"
  },
  "engines": {
    "node": ">=24"
  }
}
